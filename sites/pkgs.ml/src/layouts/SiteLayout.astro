---
import "@/styles/globals.css";

import Footer from "@/components/Footer.astro";
import TopNav from "@/components/TopNav.astro";
import { fetchSession } from "@/lib/auth";

interface Props {
  title: string;
  description?: string;
  showNavSearch?: boolean;
  navSearchQuery?: string;
}

const {
  title,
  description = "OCaml package discovery and publishing.",
  showNavSearch = true,
  navSearchQuery = "",
} = Astro.props;
const session = await fetchSession(Astro.request);
const currentUrl = Astro.url.toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-background text-foreground antialiased">
    <div class="flex min-h-screen flex-col bg-background text-foreground">
      <aside class="border-b-2 border-[#151317] bg-[#ffc43d] text-center text-[#151317] shadow-[0_4px_0_rgba(21,19,23,0.12)] [&_*]:text-[#151317]" aria-label="Tech demo notice">
        <div class="mx-auto flex min-h-10 w-full max-w-6xl flex-col items-center justify-center gap-1 px-4 py-2 sm:flex-row sm:gap-3 sm:px-6">
          <strong class="font-heading text-base font-black leading-none text-[#151317]">tech-demo</strong>
          <span class="text-xs font-bold leading-snug text-[#151317]">
            pkgs.ml is an in-progress preview. Registry data, accounts, publishing, and docs may change before release.
          </span>
        </div>
      </aside>
      <TopNav
        showSearch={showNavSearch}
        searchQuery={navSearchQuery}
        currentUrl={currentUrl}
        session={session}
      />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
