---
import { buttonVariants } from "@/components/ui/button";
import SiteLayout from "../layouts/SiteLayout.astro";
import { buildGitHubLoginUrl, fetchSession } from "../lib/auth";

const session = await fetchSession(Astro.request);
if (session.authenticated && session.user) {
  return Astro.redirect(`/u/${session.user.github_login}`);
}

const returnTo = Astro.url.searchParams.get("return_to") ?? Astro.url.origin;
const loginUrl = buildGitHubLoginUrl(returnTo);
---

<SiteLayout
  title="Log in · pkgs.ml"
  description="Log in to pkgs.ml with GitHub to publish packages and manage API tokens."
  showNavSearch={false}
  navSearchQuery=""
>
  <section class="mx-auto grid w-full max-w-sm gap-6 px-4 py-16 sm:py-24">
    <div class="grid gap-2 text-center">
      <span aria-hidden="true" class="text-3xl">📦</span>
      <h1 class="text-xl font-semibold text-kumo-strong">Log in to pkgs.ml</h1>
      <p class="text-kumo-subtle">Publish packages and manage API tokens with your GitHub account.</p>
    </div>

    <div class="grid gap-4 rounded-xl bg-kumo-base p-6 ring ring-kumo-hairline">
      <a href={loginUrl} class={buttonVariants({ variant: "default", size: "lg", className: "w-full justify-center" })}>
        <svg aria-hidden="true" class="size-4" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
        Continue with GitHub
      </a>
      <p class="text-center text-[13px] text-kumo-subtle">
        We use your GitHub login to create your pkgs.ml account and link publish tokens to the packages you own.
        You'll come back here once GitHub confirms.
      </p>
    </div>

    <p class="text-center text-[13px] text-kumo-subtle">
      Read how we handle your data in the <a href="/privacy" class="text-kumo-link hover:underline">privacy notice</a>.
    </p>
  </section>
</SiteLayout>
