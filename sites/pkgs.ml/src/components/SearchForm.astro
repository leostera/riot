---
import { buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";

interface Props {
  query?: string;
  placeholder?: string;
  large?: boolean;
  autofocus?: boolean;
}

const {
  query = "",
  placeholder = "Search packages",
  large = false,
  autofocus = false,
} = Astro.props;
---

<form
  action="/"
  method="get"
  role="search"
  class:list={[
    "flex items-center gap-2",
    large ? "mx-auto w-full max-w-[600px]" : "w-full",
  ]}
>
  <Input
    type="search"
    name="q"
    value={query}
    placeholder={placeholder}
    class:list={[
      "min-w-0 flex-1",
      large ? "h-11 px-3.5" : "h-9 px-3",
    ]}
    autoFocus={autofocus}
    autoComplete="off"
  />

  <button
    type="submit"
    class:list={[
      buttonVariants({ variant: "default", size: "default" }),
      large ? "h-11 px-5" : "h-9 px-4",
    ]}
  >
    Search
  </button>
</form>
