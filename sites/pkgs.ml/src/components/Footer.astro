---
const columns = [
  {
    title: "Registry",
    links: [
      ["Activity", "/activity"],
      ["Stats", "/stats"],
      ["Package docs", "https://docs.pkgs.ml"],
    ],
  },
  {
    title: "Developers",
    links: [
      ["API", "/api"],
      ["For agents", "/llms.txt"],
      ["Log in", "/login"],
    ],
  },
  {
    title: "Riot",
    links: [
      ["riot.ml", "https://riot.ml"],
      ["Source code", "https://github.com/leostera/riot"],
      ["Privacy", "/privacy"],
    ],
  },
];
---

<footer class="border-t border-kumo-hairline">
  <div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1.5fr_repeat(3,1fr)]">
    <div class="grid content-start gap-1.5">
      <span class="flex items-center gap-2 text-kumo-strong">
        <span aria-hidden="true">📦</span>
        <span class="font-mono font-semibold">pkgs.ml</span>
      </span>
      <p class="text-[13px] text-kumo-subtle">The package registry for the Riot OCaml stack.</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title} class="grid content-start gap-2">
          <h2 class="font-semibold text-kumo-strong">{column.title}</h2>
          <ul class="grid gap-1.5">
            {column.links.map(([label, href]) => (
              <li>
                <a href={href} class="text-kumo-subtle hover:text-kumo-default">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
</footer>
