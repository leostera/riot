---
import SearchForm from "@/components/SearchForm.astro";
import GitHubAvatar from "@/components/GitHubAvatar.astro";
import { buildGitHubLoginUrl, buildLogoutUrl } from "@/lib/auth";
import { buttonVariants } from "@/components/ui/button";
import type { SessionResponse } from "@/lib/types";

interface Props {
  showSearch?: boolean;
  searchQuery?: string;
  currentUrl?: string;
  session?: SessionResponse;
}

const {
  showSearch = false,
  searchQuery = "",
  currentUrl = "https://pkgs.ml/",
  session = { authenticated: false },
} = Astro.props;
const loginUrl = buildGitHubLoginUrl(currentUrl);
const logoutUrl = buildLogoutUrl(currentUrl);
---

<header class="sticky top-0 z-40 border-b border-kumo-hairline bg-kumo-canvas/85 backdrop-blur-md">
  <div class="mx-auto flex w-full max-w-6xl min-w-0 flex-nowrap items-center gap-2 h-14 px-4 sm:gap-3 sm:px-6">
    <a href="/" class="flex min-w-0 shrink items-center gap-2 text-kumo-strong">
      <span aria-hidden="true">📦</span>
      <span class="truncate font-mono text-[15px] font-semibold">pkgs.ml</span>
    </a>

    {
      showSearch ? (
        <div class="hidden min-w-0 flex-1 items-center justify-center gap-4 lg:flex">
          <div class="min-w-0 w-full max-w-xl">
            <SearchForm
              query={searchQuery}
              placeholder="Search packages, descriptions, owners, or repositories..."
            />
          </div>
          <nav class="hidden shrink-0 items-center gap-1 text-kumo-subtle xl:flex">
            <a href="/activity" class="rounded-md px-2.5 py-1.5 hover:bg-kumo-tint hover:text-kumo-default">Activity</a>
            <a href="/stats" class="rounded-md px-2.5 py-1.5 hover:bg-kumo-tint hover:text-kumo-default">Stats</a>
            <a href="/llms.txt" class="rounded-md px-2.5 py-1.5 hover:bg-kumo-tint hover:text-kumo-default">For agents</a>
          </nav>
        </div>
      ) : (
        <nav class="hidden min-w-0 flex-1 items-center justify-center gap-1 text-kumo-subtle lg:flex">
          <a href="/activity" class="rounded-md px-2.5 py-1.5 hover:bg-kumo-tint hover:text-kumo-default">Activity</a>
          <a href="/stats" class="rounded-md px-2.5 py-1.5 hover:bg-kumo-tint hover:text-kumo-default">Stats</a>
          <a href="/llms.txt" class="rounded-md px-2.5 py-1.5 hover:bg-kumo-tint hover:text-kumo-default">For agents</a>
        </nav>
      )
    }

    <details class="relative ml-auto shrink-0 lg:hidden">
        <summary
          class:list={[
            session.authenticated && session.user
              ? "flex h-9 w-9 list-none items-center justify-center overflow-hidden rounded-full p-0 text-foreground shadow-none outline-none transition-colors hover:opacity-90 [&::-webkit-details-marker]:hidden cursor-pointer"
              : `${buttonVariants({ variant: "outline", size: "sm" })} list-none rounded-md px-2.5 [&::-webkit-details-marker]:hidden cursor-pointer`,
          ]}
          aria-label={session.authenticated && session.user ? "Open account menu" : "Open navigation menu"}
        >
          {
            session.authenticated && session.user ? (
              <GitHubAvatar
                login={session.user.github_login}
                avatarUrl={session.user.github_avatar_url}
                size="md"
                showLogin={false}
              />
            ) : (
              <span aria-hidden="true" class="text-base leading-none">☰</span>
            )
          }
        </summary>

        <div class="absolute right-0 top-full z-50 mt-2 min-w-[260px] overflow-hidden rounded-lg bg-kumo-base shadow-lg ring ring-kumo-line">
          <div class="grid text-sm">
            {
              showSearch ? (
                <div class="border-b border-border px-3 py-3">
                  <SearchForm
                    query={searchQuery}
                    placeholder="Search packages..."
                  />
                </div>
              ) : (
                <a href="/" class="px-3 py-2 text-foreground hover:bg-kumo-tint">
                  Search
                </a>
              )
            }
            <a href="/activity" class="px-3 py-2 text-foreground hover:bg-kumo-tint">
              Activity
            </a>
            <a href="/stats" class="px-3 py-2 text-foreground hover:bg-kumo-tint">
              Stats
            </a>
            <a href="/llms.txt" class="px-3 py-2 text-foreground hover:bg-kumo-tint">
              For agents
            </a>
            {
              session.authenticated && session.user ? (
                <>
                  <div class="border-t border-border" />
                  <a
                    href={`/u/${session.user.github_login}`}
                    class="px-3 py-2 text-foreground hover:bg-kumo-tint"
                  >
                    Your profile
                  </a>
                  <a
                    href={`/u/${session.user.github_login}/tokens`}
                    class="px-3 py-2 text-foreground hover:bg-kumo-tint"
                >
                  API tokens
                  </a>
                  <form action={logoutUrl} method="post" class="border-t border-border">
                    <button
                      type="submit"
                      class="block w-full px-3 py-2 text-left text-foreground hover:bg-kumo-tint"
                    >
                      Log out
                    </button>
                  </form>
                </>
              ) : (
                <>
                  <a href={loginUrl} class="border-t border-border px-3 py-2 text-foreground hover:bg-kumo-tint">
                    Log in with GitHub
                  </a>
                </>
              )
            }
          </div>
        </div>
    </details>

    <div class="ml-auto hidden shrink-0 items-center gap-2 lg:flex">
        <button
          type="button"
          class:list={[
            buttonVariants({ variant: "ghost", size: "icon-sm" }),
          ]}
          aria-label="Toggle theme"
          data-theme-toggle
        >
          <svg aria-hidden="true" data-icon="sun" class="hidden size-4" viewBox="0 0 256 256" fill="currentColor"><path d="M120 40V16a8 8 0 0 1 16 0v24a8 8 0 0 1-16 0Zm72 88a64 64 0 1 1-64-64 64.07 64.07 0 0 1 64 64Zm-16 0a48 48 0 1 0-48 48 48.05 48.05 0 0 0 48-48ZM58.34 69.66a8 8 0 0 0 11.32-11.32l-16-16a8 8 0 0 0-11.32 11.32Zm0 116.68-16 16a8 8 0 0 0 11.32 11.32l16-16a8 8 0 0 0-11.32-11.32ZM192 72a8 8 0 0 0 5.66-2.34l16-16a8 8 0 0 0-11.32-11.32l-16 16A8 8 0 0 0 192 72Zm5.66 114.34a8 8 0 0 0-11.32 11.32l16 16a8 8 0 0 0 11.32-11.32ZM48 128a8 8 0 0 0-8-8H16a8 8 0 0 0 0 16h24a8 8 0 0 0 8-8Zm80 80a8 8 0 0 0-8 8v24a8 8 0 0 0 16 0v-24a8 8 0 0 0-8-8Zm112-88h-24a8 8 0 0 0 0 16h24a8 8 0 0 0 0-16Z"/></svg>
          <svg aria-hidden="true" data-icon="moon" class="size-4" viewBox="0 0 256 256" fill="currentColor"><path d="M233.54 142.23a8 8 0 0 0-8-2 88.08 88.08 0 0 1-109.8-109.8 8 8 0 0 0-10-10 104.84 104.84 0 0 0-52.91 37A104 104 0 0 0 136 224a103.09 103.09 0 0 0 62.52-20.88 104.84 104.84 0 0 0 37-52.91 8 8 0 0 0-1.98-7.98Zm-44.64 48.11A88 88 0 0 1 65.66 67.11a89 89 0 0 1 31.4-26A106 106 0 0 0 96 56a104.11 104.11 0 0 0 104 104 106 106 0 0 0 14.92-1.06 89 89 0 0 1-26.02 31.4Z"/></svg>
          <span class="sr-only">Toggle theme</span>
        </button>

        {
          session.authenticated && session.user ? (
            <details class="relative">
              <summary
                class:list={[
                  buttonVariants({ variant: "outline", size: "sm" }),
                  "list-none rounded-md gap-2 px-2.5 [&::-webkit-details-marker]:hidden cursor-pointer",
                ]}
              >
                <GitHubAvatar
                  login={session.user.github_login}
                  avatarUrl={session.user.github_avatar_url}
                  size="md"
                  showLogin={false}
                />
              </summary>

              <div class="absolute right-0 top-full z-50 mt-2 min-w-[192px] overflow-hidden rounded-lg bg-kumo-base shadow-lg ring ring-kumo-line">
                <div class="grid text-sm">
                  <a
                    href={`/u/${session.user.github_login}`}
                    class="px-3 py-2 text-foreground hover:bg-kumo-tint"
                  >
                    Your profile
                  </a>
                  <a
                    href={`/u/${session.user.github_login}/tokens`}
                    class="px-3 py-2 text-foreground hover:bg-kumo-tint"
                  >
                    API tokens
                  </a>
                  <form action={logoutUrl} method="post" class="border-t border-border">
                    <button
                      type="submit"
                      class="block w-full px-3 py-2 text-left text-foreground hover:bg-kumo-tint"
                    >
                      Log out
                    </button>
                  </form>
                </div>
              </div>
            </details>
          ) : (
            <a
              href={loginUrl}
              class:list={[
                buttonVariants({ variant: "default", size: "sm" }),
                "rounded-md",
              ]}
            >
              Log in with GitHub
            </a>
          )
        }
    </div>
  </div>
</header>

<script is:inline>
  const root = document.documentElement;
  const buttons = Array.from(document.querySelectorAll("[data-theme-toggle]"));

  const syncIcons = (theme) => {
    for (const button of buttons) {
      button.querySelector("[data-icon=sun]")?.classList.toggle("hidden", theme !== "dark");
      button.querySelector("[data-icon=moon]")?.classList.toggle("hidden", theme === "dark");
    }
  };

  const applyTheme = (theme) => {
    root.dataset.mode = theme;
    root.classList.toggle("dark", theme === "dark");
    try {
      localStorage.setItem("pkgs-theme", theme);
    } catch {}
    syncIcons(theme);
  };

  syncIcons(root.dataset.mode === "dark" ? "dark" : "light");

  for (const button of buttons) {
    button.addEventListener("click", () => {
      applyTheme(root.dataset.mode === "dark" ? "light" : "dark");
      const details = button.closest("details");
      if (details instanceof HTMLDetailsElement) {
        details.open = false;
      }
    });
  }
</script>
