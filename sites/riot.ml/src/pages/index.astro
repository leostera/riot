---
import { Badge, LayerCard, Link, LinkButton, Text } from "@cloudflare/kumo";
import {
  ArrowRightIcon,
  BrowserIcon,
  CloudIcon,
  CpuIcon,
  DatabaseIcon,
  GithubLogoIcon,
  PackageIcon,
  RobotIcon,
  StackIcon,
  TerminalWindowIcon,
  WrenchIcon,
} from "@phosphor-icons/react";
import { CodeSample } from "../components/CodeSample";
import { CommandExplorer } from "../components/CommandExplorer";
import HeroAsciinemaPlayer from "../components/HeroAsciinemaPlayer.astro";
import { InlineText } from "../components/InlineText";
import { InstallCommand } from "../components/InstallCommand";
import { ThemeToggle } from "../components/ThemeToggle";
import SiteLayout from "../layouts/SiteLayout.astro";

const links = {
  packageDocs: "https://docs.pkgs.ml",
  packages: "https://pkgs.ml",
  source: "https://github.com/leostera/riot",
  sponsor: "https://github.com/sponsors/leostera",
  author: "https://x.com/leostera",
  llms: "/llms.txt",
};

const nav = [
  { label: "Workflow", href: "#workflow" },
  { label: "For agents", href: "#agents" },
  { label: "What you can build", href: "#build" },
  { label: "Packages", href: links.packages },
];

const pillars = [
  {
    icon: TerminalWindowIcon,
    title: "One CLI",
    body: "Build, test, format, lint, fuzz, benchmark, document, and publish with `riot`.",
  },
  {
    icon: CpuIcon,
    title: "Actor runtime",
    body: "A multicore actor runtime with supervision and message passing, built in.",
  },
  {
    icon: StackIcon,
    title: "New standard library",
    body: "A modern, practical standard library designed for systems and services.",
  },
  {
    icon: PackageIcon,
    title: "pkgs.ml registry",
    body: "Search, add, and publish packages, with docs generated for every release.",
  },
];

const useCases = [
  {
    icon: CpuIcon,
    title: "Multicore applications",
    body: "Spawn and supervise actors with `std/actor` and let the runtime in `std/runtime` use every core you have.",
  },
  {
    icon: CloudIcon,
    title: "Networked services",
    body: "Actors, supervision, and real IO. `std/IO` includes `ioSlice` for zero-copy work when bytes need to move fast.",
  },
  {
    icon: BrowserIcon,
    title: "Web applications",
    body: "Build web apps with `suri`, including LiveView support in `suri/liveview` and typed domain logic.",
  },
  {
    icon: DatabaseIcon,
    title: "Database-backed systems",
    body: "Typed queries with `sqlx`, PostgreSQL through `postgres`, and `sqlite` when a file is all you need.",
  },
  {
    icon: TerminalWindowIcon,
    title: "Command-line tools",
    body: "Fast CLIs with structured output and clear errors that people and agents can both drive.",
  },
  {
    icon: StackIcon,
    title: "Terminal UIs",
    body: "Keyboard-driven terminal interfaces with `minttea` and `gooey`, with structured state and native ergonomics.",
  },
  {
    icon: WrenchIcon,
    title: "Developer tooling",
    body: "Formatters, linters, code generators, and release tools, written with the toolchain they plug into.",
  },
  {
    icon: RobotIcon,
    title: "Agentic workflows",
    body: "Workflows agents can run, inspect, and repair: JSON output, stable diagnostics, and recoverable failures.",
  },
];

const agentPoints = [
  "Every `riot init` workspace ships with a `.agents` folder and the Riot skill already in place.",
  "Commands support `--json`, so agents read build results, diagnostics, and test runs as data instead of scraping prose.",
  "The skill links workflows for testing, fuzzing, benchmarking, and snapshots, so agents run the right loop instead of guessing.",
  "`/llms.txt` gives agents on the web a map of Riot and pkgs.ml.",
];

const agentSample = `$ riot init app && cd app
$ ls .agents/skills
riot-ml

$ riot build --json
$ riot test --json
$ riot search std --json`;
---

<SiteLayout
  title="Riot · An opinionated OCaml stack"
  description="Riot is one CLI for building, testing, and shipping OCaml, with a multicore actor runtime, a new standard library, and the pkgs.ml package registry."
>
  <div class="border-b border-kumo-hairline bg-kumo-elevated">
    <p class="mx-auto flex max-w-6xl items-center justify-center gap-2 px-4 py-2 text-center text-[13px] text-kumo-strong sm:px-6">
      <Badge variant="beta">Tech preview</Badge>
      <span>Commands, packages, and APIs may change before 1.0.</span>
    </p>
  </div>

  <header class="sticky top-0 z-40 border-b border-kumo-hairline bg-kumo-canvas/85 backdrop-blur-md">
    <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
      <a href="/" class="flex items-center gap-2 text-kumo-strong" aria-label="Riot home">
        <span aria-hidden="true" class="text-lg leading-none">🏴‍☠️</span>
        <span class="font-mono text-[15px] font-semibold">riot</span>
      </a>
      <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="rounded-md px-2.5 py-1.5 text-kumo-subtle hover:bg-kumo-tint hover:text-kumo-default"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto flex items-center gap-1">
        <LinkButton
          href={links.source}
          variant="ghost"
          shape="square"
          aria-label="Riot on GitHub"
          title="Riot on GitHub"
        >
          <GithubLogoIcon size={16} />
        </LinkButton>
        <ThemeToggle client:load />
        <LinkButton href={links.packages} variant="primary" size="sm" className="ml-1 hidden sm:inline-flex">
          Browse packages
        </LinkButton>
      </div>
    </div>
    <nav aria-label="Primary" class="flex gap-1 overflow-x-auto border-t border-kumo-hairline px-3 py-1.5 md:hidden">
      {
        nav.map((item) => (
          <a href={item.href} class="shrink-0 rounded-md px-2.5 py-1 text-kumo-subtle hover:bg-kumo-tint hover:text-kumo-default">
            {item.label}
          </a>
        ))
      }
    </nav>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
      <div class="riot-hero-backdrop absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-16 pb-20 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:pt-24 lg:pb-28">
        <div class="grid gap-8">
          <div class="grid gap-4">
            <p class="font-mono text-[13px] text-kumo-brand">There are many OCaml stacks. This one is mine.</p>
            <h1
              id="hero-title"
              class="text-4xl leading-[1.08] font-semibold text-kumo-strong sm:text-5xl lg:text-[3.5rem]"
            >
              The OCaml stack that gets out of your way.
            </h1>
            <p class="max-w-xl text-base leading-relaxed text-kumo-strong sm:text-lg">
              Riot is one CLI for building, testing, and shipping OCaml, with a multicore actor
              runtime, a new standard library, and the pkgs.ml registry. Opinionated by design,
              and built to be driven by you or your agents.
            </p>
          </div>

          <div class="grid gap-3">
            <InstallCommand client:load />
            <p class="text-[13px] text-kumo-subtle">
              macOS and Linux. Installs to <code class="riot-inline-code">~/.riot/bin</code>.
            </p>
          </div>

          <div class="flex flex-wrap gap-2">
            <LinkButton href="#workflow" variant="primary" icon={TerminalWindowIcon}>
              See the workflow
            </LinkButton>
            <LinkButton href={links.source} variant="secondary" icon={GithubLogoIcon}>
              View on GitHub
            </LinkButton>
          </div>
        </div>

        <HeroAsciinemaPlayer castUrl="/riot.cast" title="curl -sSL https://get.riot.ml | sh" />
      </div>
    </section>

    <!-- Pillars -->
    <section aria-label="What Riot includes" class="border-y border-kumo-hairline bg-kumo-base">
      <div class="mx-auto grid max-w-6xl gap-px bg-kumo-hairline sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((pillar) => (
            <div class="grid content-start gap-3 bg-kumo-base px-6 py-7">
              <span class="flex size-8 items-center justify-center rounded-lg bg-kumo-tint text-kumo-brand">
                <pillar.icon size={18} />
              </span>
              <div class="grid gap-1">
                <Text variant="heading" as="h2">
                  {pillar.title}
                </Text>
                <Text variant="secondary">
                  <InlineText text={pillar.body} />
                </Text>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Commands -->
    <section id="workflow" class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:py-24 sm:px-6" aria-labelledby="workflow-title">
      <div class="grid max-w-2xl gap-3">
        <p class="font-mono text-[13px] text-kumo-brand">riot --help</p>
        <h2 id="workflow-title" class="text-3xl leading-tight font-semibold text-kumo-strong sm:text-4xl">
          One tool for the whole loop
        </h2>
        <p class="text-base leading-relaxed text-kumo-strong">
          From a fresh workspace to a published package, every step is a <code class="riot-inline-code">riot</code>
          command with the same flags, the same toolchain, and structured output when you need it.
        </p>
      </div>
      <CommandExplorer client:visible />
    </section>

    <!-- Agents -->
    <section id="agents" class="border-y border-kumo-hairline bg-kumo-base" aria-labelledby="agents-title">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:py-24 sm:px-6 lg:grid-cols-2">
        <div class="grid gap-6">
          <div class="grid gap-3">
            <p class="font-mono text-[13px] text-kumo-brand">.agents/skills/riot-ml</p>
            <h2 id="agents-title" class="text-3xl leading-tight font-semibold text-kumo-strong sm:text-4xl">
              Agents are first-class users
            </h2>
            <p class="text-base leading-relaxed text-kumo-strong">
              Riot ships instructions for agents alongside the docs for people, so the tools you
              already use know how to build, test, and ship a Riot project from the first prompt.
            </p>
          </div>
          <ul class="grid gap-3">
            {
              agentPoints.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="flex h-lh items-center text-kumo-brand" aria-hidden="true">
                    <ArrowRightIcon size={14} weight="bold" />
                  </span>
                  <span class="text-kumo-default">
                    <InlineText text={point} />
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="flex flex-wrap gap-2">
            <LinkButton href={links.llms} variant="secondary" icon={RobotIcon}>
              Read llms.txt
            </LinkButton>
            <LinkButton href="https://pkgs.ml/llms.txt" variant="ghost">
              pkgs.ml for agents
            </LinkButton>
          </div>
        </div>
        <LayerCard>
          <LayerCard.Secondary className="flex items-center justify-between">
            <span>Agent-ready from the first command</span>
            <Badge variant="outline" className="font-mono">--json</Badge>
          </LayerCard.Secondary>
          <LayerCard.Primary className="p-0">
            <CodeSample code={agentSample} className="rounded-none bg-transparent px-5 py-4 ring-0" />
          </LayerCard.Primary>
        </LayerCard>
      </div>
    </section>

    <!-- Use cases -->
    <section id="build" class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:py-24 sm:px-6" aria-labelledby="build-title">
      <div class="grid max-w-2xl gap-3">
        <h2 id="build-title" class="text-3xl leading-tight font-semibold text-kumo-strong sm:text-4xl">
          What you can build with Riot
        </h2>
        <p class="text-base leading-relaxed text-kumo-strong">
          Tools, services, databases, and experiments, built as one codebase that stays understandable
          as it grows.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          useCases.map((useCase) => (
            <LayerCard className="h-full">
              <LayerCard.Primary className="grid h-full content-start gap-3 px-5 py-4">
                <span class="text-kumo-brand" aria-hidden="true">
                  <useCase.icon size={20} />
                </span>
                <div class="grid gap-1">
                  <Text variant="heading" as="h3">
                    {useCase.title}
                  </Text>
                  <Text variant="secondary">
                    <InlineText text={useCase.body} />
                  </Text>
                </div>
              </LayerCard.Primary>
            </LayerCard>
          ))
        }
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="px-4 pb-16 sm:px-6 sm:pb-24" aria-labelledby="cta-title">
      <div class="mx-auto grid max-w-6xl justify-items-center gap-6 rounded-2xl bg-kumo-contrast px-6 py-16 text-center">
        <div class="grid gap-2">
          <h2 id="cta-title" class="text-3xl font-semibold text-kumo-inverse sm:text-4xl">Start a Riot project</h2>
          <p class="text-base text-kumo-inverse/70">Install the CLI, run <code class="font-mono text-[0.9em]">riot init</code>, and you're building.</p>
        </div>
        <div class="w-full max-w-md text-left">
          <InstallCommand client:load />
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          <LinkButton href={links.packages} variant="primary" icon={PackageIcon}>
            Browse packages
          </LinkButton>
          <LinkButton href={links.source} variant="secondary" icon={GithubLogoIcon}>
            Star on GitHub
          </LinkButton>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-kumo-hairline">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.5fr_repeat(3,1fr)]">
      <div class="grid content-start gap-2">
        <span class="flex items-center gap-2 text-kumo-strong">
          <span aria-hidden="true" class="text-base leading-none">🏴‍☠️</span>
          <span class="font-mono font-semibold">riot</span>
        </span>
        <Text variant="secondary" size="sm">
          An opinionated OCaml stack by <Link href={links.author}>@leostera</Link>.
        </Text>
      </div>
      {
        [
          {
            title: "Product",
            items: [
              ["Package registry", links.packages],
              ["Package docs", links.packageDocs],
            ],
          },
          {
            title: "Project",
            items: [
              ["Source code", links.source],
              ["Sponsor", links.sponsor],
              ["@leostera", links.author],
            ],
          },
          {
            title: "For agents",
            items: [
              ["riot.ml/llms.txt", links.llms],
              ["pkgs.ml/llms.txt", "https://pkgs.ml/llms.txt"],
            ],
          },
        ].map((column) => (
          <nav aria-label={column.title} class="grid content-start gap-2">
            <Text variant="heading" as="h2">
              {column.title}
            </Text>
            <ul class="grid gap-1.5">
              {column.items.map(([label, href]) => (
                <li>
                  <a href={href} class="text-kumo-subtle hover:text-kumo-default">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </footer>
</SiteLayout>
